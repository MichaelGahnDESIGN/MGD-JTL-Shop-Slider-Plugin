<?xml version="1.0" encoding="UTF-8"?>
<jtlshopplugin>
    <Name>MGD Slider</Name>
    <Description>Slider für JTL-Shop 5: klassisch mit eigenen Slides oder Prime mit Slides automatisch aus Shop-Artikeln. Barrierefrei bedienbar. Pre-Release, bisher nur mit JTL-Shop 5.8.2 getestet.</Description>
    <Author>Michael Gahn DESIGN</Author>
    <URL>https://themes.michael-gahn.de</URL>
    <PluginID>mgd_slider</PluginID>
    <XMLVersion>100</XMLVersion>
    <MinShopVersion>5.8.2</MinShopVersion>
    <CreateDate>2026-11-06</CreateDate>
    <Version>0.1.2</Version>
    <Install>
        <FlushTags>CACHING_GROUP_TEMPLATE,CACHING_GROUP_PLUGIN</FlushTags>
        <Adminmenu>
            <Customlink sort="1">
                <Name>Slider</Name>
            </Customlink>
            <Customlink sort="2">
                <Name>Lizenzen</Name>
            </Customlink>
            <Customlink sort="3">
                <Name>Updates</Name>
            </Customlink>
        </Adminmenu>
        <Portlets>
            <Portlet>
                <Title>MGD Slider</Title>
                <Class>MGDSlider</Class>
                <Group>content</Group>
                <Active>1</Active>
            </Portlet>
        </Portlets>
        <CSS>
            <file>
                <name>mgd-slider.css</name>
                <priority>5</priority>
            </file>
        </CSS>
        <JS>
            <file>
                <name>mgd-slider.js</name>
                <priority>5</priority>
                <position>body</position>
            </file>
        </JS>
    </Install>
</jtlshopplugin>
